# Example only; the application does not load this file automatically.
CENTRAL_DEPLOYMENT_MODE=local
CENTRAL_COMMAND_RUNNER=host
CENTRAL_JOB_MODE=embedded
CENTRAL_DOCKER_INSTALL_NETWORK=none
CENTRAL_EMBEDDING_URL=http://127.0.0.1:11434
CENTRAL_EMBEDDING_MODEL=nomic-embed-text
# Server mode also requires:
# CENTRAL_PUBLIC_ORIGIN=https://central.example.com
# CENTRAL_SECRET_KEY=<externally-managed-fernet-key>
# Independent backup key:
# CENTRAL_BACKUP_KEY=<independent-fernet-key>
